APP_ENV=production
APP_NAME=HomeLAB OpenLDAP Manager
WEB_LISTEN_ADDRESS=0.0.0.0
WEB_PORT=8080
DATABASE_URL=sqlite:////var/lib/homelab-openldap-manager/app.db
SECRET_KEY=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
ENCRYPTION_KEY=CHANGE_ME_WITH_FERNET_KEY
SESSION_HTTPS_ONLY=true
SESSION_MAX_AGE=3600
ENABLE_DOCS=false
LOG_LEVEL=INFO
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_STARTTLS=false
LDAP_VERIFY_TLS=true
LDAP_CA_CERT=
LDAP_CONNECT_TIMEOUT=10
LDAP_CACHE_TTL=300
USERS_BASE_DN=
GROUPS_BASE_DN=
UID_MIN=10000
UID_MAX=60000
GID_MIN=10000
GID_MAX=60000
